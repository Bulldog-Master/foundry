def jcs(o): return json.dumps(o, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
def sha(b): return hashlib.sha256(b).hexdigest()
def b64url(b): return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def read_root_file(path,max_bytes=8_000_000): return read_root(path,max_bytes)


def api(method, path, token, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(API + path, data=data, method=method, headers={
        "Authorization": "Bearer " + token, "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": VERSION, "User-Agent": "foundry-evaluator-publisher/0.1",
        "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r: return json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise Reject("GitHub HTTP %s for %s %s" % (e.code, method, path))


def installation_token(cfg):
    now = int(time.time())
    header = b64url(jcs({"alg":"RS256","typ":"JWT"}))
    payload = b64url(jcs({"iat":now-30,"exp":now+540,"iss":str(cfg["app_id"])}))
    key = serialization.load_pem_private_key(read_root_file(APP_KEY, 100_000), password=None)
    sig = key.sign((header+"."+payload).encode(), padding.PKCS1v15(), hashes.SHA256())
    jwt = header+"."+payload+"."+b64url(sig)
    app=api('GET','/app',jwt)
    installation=api('GET','/app/installations/%s'%cfg['installation_id'],jwt)
    if app.get('id')!=cfg['app_id'] or app.get('slug')!='foundry-evaluator' or installation.get('app_id')!=cfg['app_id']: raise Reject('App identity mismatch')
    permissions=installation.get('permissions',{})
    expected={'checks':'write','contents':'read','pull_requests':'write','metadata':'read'}
    if permissions!=expected or installation.get('repository_selection')!='selected': raise Reject('App permission/selection drift')
    result = api("POST", "/app/installations/%s/access_tokens" % cfg["installation_id"], jwt,
                 {"repository_ids":[cfg["repository_id"]],
                  "permissions":{"checks":"write","contents":"read","pull_requests":"write"}})
    if result.get('permissions')!={'checks':'write','contents':'read','pull_requests':'write','metadata':'read'}: raise Reject('token permissions mismatch')
    return result['token']


def load_json(path): return parse(read_root_file(path))


def validate_evidence(packet_dir, run_dir):
    profile = load_json(PROFILE)
    task = read_root_file(TASK)
    m,members = validate_packet(packet_dir,profile,task)
    result = load_json(run_dir+'/result.json')
    record = load_json(run_dir+'/invocation-record.json')
    schema('invocation-record.schema.json',record)
    validate_result(result,m,members)
    if record['accessible_context']!=ALLOWED or record['tools_available'] or record['credentials_present'] or record['network_policy']!='none': raise Reject('context violation')
    if record['prior_exposure']['known_prior_sessions_on_this_pr']: raise Reject('prior exposure requires human eligibility review')
    if record['transport_outcome']!='COMPLETED': raise Reject('incomplete transport')
    if record['packet_sha256']!=m['packet_sha256'] or record['schema_validation']!='VALID' or record['routing_check']!='MATCHES_TABLE': raise Reject('invalid evaluation')
    if record['evaluator']['system_prompt_sha256']!=sha(task): raise Reject('prompt mismatch')
    config = load_json(os.path.dirname(TASK)+'/config.json')
    if record['evaluator']['config_sha256']!=sha(jcs(config)): raise Reject('configuration mismatch')
    if record['environment']['runtime_image_sha256']!=sha(read_root_file(os.path.dirname(TASK)+'/RUNTIME.json')+read_root_file(os.path.dirname(TASK)+'/MANIFEST.sha256')): raise Reject('runtime image binding')
    raw = read_root_file(run_dir+'/raw-response.json')
    if record['raw_output_sha256']!=sha(raw) or record['raw_output_bytes']!=len(raw): raise Reject('raw output mismatch')
    response,text=provider_response(raw,config['model'])
    if parse(text)!=result: raise Reject('raw/result mismatch')
    if response.get('model')!=record['evaluator']['model_id']: raise Reject('observed model binding')
    outcome,signals=adverse(text)
    if record['adverse_signal_scan']!={'algorithm_version':'0.1','outcome':outcome,'matched_signals':signals}: raise Reject('adverse scan mismatch')
    disclosure=record['pre_transmission_disclosure']
    if disclosure['packet_sha256']!=m['packet_sha256'] or disclosure['scan_outcome']!='CLEAN' or disclosure['repository_visibility']!='PUBLIC' or disclosure['fork_visibility']!='NOT_A_FORK' or not disclosure['provider_terms_accepted']: raise Reject('disclosure failure')
    if disclosure['provider_terms_sha256']!=sha(read_root_file(os.path.dirname(TASK)+'/provider-terms.json')): raise Reject('provider terms mismatch')
    chunks=[jcs(m),*members.values(),task]
    scanner=SCANNER
    if disclosure['scanner_sha256']!=sha(read_root_file(scanner)) or scan(chunks) or disclosure['members_scanned']!=len(chunks) or disclosure['bytes_scanned']!=sum(map(len,chunks)): raise Reject('disclosure scan binding')
    rsha=sha(jcs(result))
    rr=dict(record); rrhash=rr.pop('review_record_sha256')
    if record['result_sha256']!=rsha or sha(jcs({'packet_sha256':m['packet_sha256'],'result_sha256':rsha,'invocation_record_without_hash':rr}))!=rrhash: raise Reject('review record hash')
    if record['attempt']==2:
        previous=load_json(os.path.dirname(run_dir)+'/attempt-1/invocation-record.json')
        schema('invocation-record.schema.json',previous)
        prevdir=pathlib.Path(run_dir).parent/'attempt-1'
        prevraw=read_root_file(prevdir/'raw-response.json')
        prevbody=dict(previous); prevhash=prevbody.pop('review_record_sha256')
        if previous['attempt']!=1 or previous['packet_sha256']!=m['packet_sha256'] or previous['result_sha256'] is not None or previous['evaluator']['system_prompt_sha256']!=record['evaluator']['system_prompt_sha256']: raise Reject('retry binding')
        if previous['raw_output_bytes']!=len(prevraw) or previous['raw_output_sha256']!=(sha(prevraw) if prevraw else None): raise Reject('retry raw binding')
        if sha(jcs({'packet_sha256':m['packet_sha256'],'result_sha256':None,'invocation_record_without_hash':prevbody}))!=prevhash: raise Reject('retry record hash')
        if previous['schema_validation']=='VALID' or previous['adverse_signal_scan']['outcome']!='NONE' or previous['transport_outcome']!='COMPLETED' or previous['evaluator']['config_sha256']!=record['evaluator']['config_sha256']: raise Reject('ineligible retry')
    return m,result,record,rsha,rrhash


RECOVERY_MANIFEST='258fdf6813af1353efebd134e2a3ba46cbfbe4e24776ae1307e300ab460e224a'
RECOVERY_RELEASE_PATH='/opt/foundry-evaluator/releases/'+RECOVERY_MANIFEST
RECOVERY_PACKET='f1efc313cd27a05e84b85c48438137aae2ea8bcb32f4b7b10a928a3aeffebf8b'

def select_retained_release(path, packet_dir, run_dir):
    """Explicit compatibility for one retained result; never rewrites its evidence."""
    global PROFILE, TASK, SCANNER, schema, validate_packet, validate_result, adverse, scan
    release=pathlib.Path(path)
    if str(release)!=RECOVERY_RELEASE_PATH: raise Reject('unapproved evidence release')
    if sha(read_root_file(release/'MANIFEST.sha256'))!=RECOVERY_MANIFEST: raise Reject('evidence release manifest mismatch')
    verify_release(release)
    manifest=load_json(str(pathlib.Path(packet_dir)/'manifest.json'))
    record=load_json(str(pathlib.Path(run_dir)/'invocation-record.json'))
    if manifest['packet_sha256']!=RECOVERY_PACKET or record['packet_sha256']!=RECOVERY_PACKET or record['attempt']!=2 or record['schema_validation']!='VALID': raise Reject('unapproved retained evidence')
    import importlib.util
    def trusted_module(name):
        file=release/'bin'/name
        read_root_file(file)
        spec=importlib.util.spec_from_file_location('retained_'+name[:-3],file)
        module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
        return module
    contract=trusted_module('runtime_contract.py')
    invocation=trusted_module('runtime_invoke.py')
    PROFILE=str(release/'profile.json'); TASK=str(release/'evaluator-task.md'); SCANNER=release/'bin'/'runtime_invoke.py'
    schema=contract.schema; validate_packet=contract.validate_packet
    validate_result=contract.validate_result; adverse=contract.adverse; scan=invocation.scan


def render(result, packet_sha, result_sha, record_sha):
    lines = ["Independent Foundry evaluator result", "", "- Head: `"+result["head_sha"]+"`",
             "- Packet: `"+packet_sha+"`", "- Result: `"+result_sha+"`",
             "- Review record: `"+record_sha+"`", "- Overall: **"+result["overall"]+"**",
             "- Routing: **"+result["routing"]+"**", "", "Gate verdicts:"]
    for name in ("architecture","security","privacy","quality"):
        lines.append("- %s: **%s**" % (name, result["gates"][name]["verdict"]))
    if result['findings']:
        lines += ['', 'Findings (quoted structured data):']
        for finding in result['findings']:
            lines += ['```json',json.dumps(finding,sort_keys=True,ensure_ascii=False),'```']
    lines += ["", "This text is rendered mechanically from the schema-valid evaluator result."]
    return "\n".join(lines)

def validate_controller_stop(packet_dir,run_dir):
    m,members=validate_packet(packet_dir,load_json(PROFILE),read_root_file(TASK))
    record=load_json(run_dir+'/invocation-record.json'); schema('invocation-record.schema.json',record)
    if record['schema_validation']=='VALID' or record['packet_sha256']!=m['packet_sha256']: raise Reject('not an invalid controller outcome')
    if record['attempt']==1 and record['transport_outcome']=='COMPLETED' and record['adverse_signal_scan']['outcome']=='NONE': raise Reject('first invalid output is retry-eligible, not terminal')
    raw=read_root_file(run_dir+'/raw-response.json')
    if record['raw_output_bytes']!=len(raw) or record['raw_output_sha256']!=(sha(raw) if raw else None): raise Reject('raw output binding')
    rr=dict(record); rrhash=rr.pop('review_record_sha256')
    if sha(jcs({'packet_sha256':m['packet_sha256'],'result_sha256':None,'invocation_record_without_hash':rr}))!=rrhash: raise Reject('review record binding')
    text='\n'.join(['Controller outcome: invalid evaluation; human resolution required.',
        'Head: `'+m['head_sha']+'`','Packet: `'+m['packet_sha256']+'`',
        'Result: null','Review record: `'+rrhash+'`','Routing: HARD_STOP',
        'No valid gate verdicts exist for this invocation. All attempts remain retained.'])
    return m,text,rrhash


def main():
    os.umask(0o077)
    if os.geteuid()!=0: raise Reject('must run as root')
    retained=len(sys.argv)==5 and sys.argv[1]=='--retained-release'
    if retained:
        evidence_release=sys.argv[2]; sys.argv=[sys.argv[0],*sys.argv[3:]]
    controller_stop=len(sys.argv)==4 and sys.argv[1]=='--controller-stop'
    if controller_stop: sys.argv=[sys.argv[0],*sys.argv[2:]]
    if len(sys.argv) != 3: raise SystemExit("usage: foundry-evaluator-publish [--controller-stop] PACKET_DIR RUN_DIR")
    verify_release(RELEASE)
    if retained: select_retained_release(evidence_release,os.path.realpath(sys.argv[1]),os.path.realpath(sys.argv[2]))
    cfg = load_json(APP_CONFIG)
    if cfg != {'app_id':5263160,'installation_id':169955633,'repository_id':1297877588,'owner':'Bulldog-Master','repo':'foundry'}: raise Reject('unapproved App configuration')
    if controller_stop:
        m,text,rrsha=validate_controller_stop(os.path.realpath(sys.argv[1]),os.path.realpath(sys.argv[2]))
        r=None
    else:
        m,r,rec,rsha,rrsha = validate_evidence(os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2]))
    if (m["repository"]["owner"],m["repository"]["name"],m["repository"]["repo_id"]) != (cfg["owner"],cfg["repo"],cfg["repository_id"]):
        raise Reject("repository binding mismatch")
    token = installation_token(cfg)
    pr = api("GET","/repos/%s/%s/pulls/%s"%(cfg["owner"],cfg["repo"],m["pr_number"]),token)
    if pr["state"] != "open" or pr["head"]["sha"] != m["head_sha"]: raise Reject("stale or closed PR")
    if r is not None: text = render(r,m["packet_sha256"],rsha,rrsha)
    if len(text.encode())>60000: raise Reject('publication size exceeds limit; no truncation')
    if controller_stop: conclusion,event='action_required','REQUEST_CHANGES'
    elif r["overall"] == "PASS" and r["routing"] == "CONTINUE" and not r["requires_human"]:
        conclusion,event = "success","APPROVE"
    elif r['routing']=='ESCALATE_FOUNDER': conclusion,event='action_required','REQUEST_CHANGES'
    else: conclusion,event='failure','REQUEST_CHANGES'
    import fcntl
    journal=pathlib.Path(sys.argv[2])/'publication'; journal.mkdir(mode=0o700,exist_ok=True)
    with open(journal/'lock','a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        def current():
            live=api('GET','/repos/%s/%s/pulls/%s'%(cfg['owner'],cfg['repo'],m['pr_number']),token)
            if live['state']!='open' or live['head']['sha']!=m['head_sha']: raise Reject('stale or closed PR')
        current()
        if (journal/'completed.json').exists():
            print((journal/'completed.json').read_text()); return
        if (journal/'uncertain.json').exists(): raise Reject('HARD_STOP: uncertain publication; reconcile GitHub IDs before retry')
        put(journal,'uncertain.json',jcs({'head_sha':m['head_sha'],'review_record_sha256':rrsha}))
        check = api("POST","/repos/%s/%s/check-runs"%(cfg["owner"],cfg["repo"]),token,
                    {"name":"foundry/four-gate","head_sha":m["head_sha"],"status":"completed",
                     "conclusion":conclusion,"completed_at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                     "output":{"title":"Foundry evaluator: "+('INVALID' if controller_stop else r["overall"]),"summary":text}})
        put(journal,'check.json',jcs(check))
        if check.get('app',{}).get('id')!=cfg['app_id'] or check.get('head_sha')!=m['head_sha']: raise Reject('returned check App/head source mismatch')
        current()
        review = api("POST","/repos/%s/%s/pulls/%s/reviews"%(cfg["owner"],cfg["repo"],m["pr_number"]),token,
                     {"commit_id":m["head_sha"],"event":event,"body":text})
        put(journal,'review.json',jcs(review))
        if review.get('commit_id')!=m['head_sha'] or review.get('user',{}).get('login')!='foundry-evaluator[bot]' or review.get('user',{}).get('type')!='Bot': raise Reject('returned review App/head source mismatch')
        current()
        completed={"check_run_id":check["id"],"review_id":review["id"],"head_sha":m["head_sha"],
                          "packet_sha256":m["packet_sha256"],"conclusion":conclusion,"review_event":event}
        put(journal,'completed.json',jcs(completed))
        print(json.dumps(completed,sort_keys=True))


if __name__ == "__main__":
    try: main()
    except (Reject,KeyError,ValueError,OSError) as e:
        print("REFUSED: "+str(e),file=sys.stderr); raise SystemExit(2)
