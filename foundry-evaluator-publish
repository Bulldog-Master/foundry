#!/usr/bin/env python3
"""Validate and publish one sealed Foundry evaluator result via a GitHub App."""
import base64, datetime, hashlib, json, os, re, stat, sys, time, urllib.error, urllib.request
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding
from jsonschema import Draft202012Validator

ETC = "/etc/foundry-evaluator"
APP_CONFIG = ETC + "/github-app.json"
APP_KEY = ETC + "/github-app.pem"
SCHEMA_DIR = "/opt/foundry-evaluator/current/schemas"
PROFILE = "/opt/foundry-evaluator/current/profile.json"
TASK = "/opt/foundry-evaluator/current/evaluator-task.md"
API = "https://api.github.com"
VERSION = "2022-11-28"
H64 = re.compile(r"^[0-9a-f]{64}$")


class Reject(Exception): pass


def jcs(o): return json.dumps(o, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
def sha(b): return hashlib.sha256(b).hexdigest()
def b64url(b): return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def read_root_file(path, max_bytes=8_000_000):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode): raise Reject("not regular: " + path)
        if st.st_uid != 0 or st.st_mode & 0o022: raise Reject("unsafe owner/mode: " + path)
        data = os.read(fd, max_bytes + 1)
        if len(data) > max_bytes: raise Reject("file too large: " + path)
        return data
    finally: os.close(fd)


def api(method, path, token, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(API + path, data=data, method=method, headers={
        "Authorization": "Bearer " + token, "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": VERSION, "User-Agent": "foundry-evaluator-publisher/0.1",
        "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r: return json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise Reject("GitHub HTTP %s for %s %s" % (e.code, method, path))


def installation_token(cfg):
    now = int(time.time())
    header = b64url(jcs({"alg":"RS256","typ":"JWT"}))
    payload = b64url(jcs({"iat":now-30,"exp":now+540,"iss":str(cfg["app_id"])}))
    key = serialization.load_pem_private_key(read_root_file(APP_KEY, 100_000), password=None)
    sig = key.sign((header+"."+payload).encode(), padding.PKCS1v15(), hashes.SHA256())
    jwt = header+"."+payload+"."+b64url(sig)
    result = api("POST", "/app/installations/%s/access_tokens" % cfg["installation_id"], jwt,
                 {"repository_ids":[cfg["repository_id"]],
                  "permissions":{"checks":"write","contents":"read","pull_requests":"write"}})
    return result["token"]


def load_json(path): return json.loads(read_root_file(path).decode())


def validate_evidence(packet_dir, run_dir):
    manifest = load_json(packet_dir + "/manifest.json")
    result = load_json(run_dir + "/result.json")
    record = load_json(run_dir + "/invocation-record.json")
    Draft202012Validator(load_json(SCHEMA_DIR+"/review-packet.schema.json")).validate(manifest)
    Draft202012Validator(load_json(SCHEMA_DIR+"/review-result.schema.json")).validate(result)
    Draft202012Validator(load_json(SCHEMA_DIR+"/invocation-record.schema.json")).validate(record)
    body = dict(manifest); declared = body.pop("packet_sha256")
    if not H64.match(declared) or sha(jcs(body)) != declared: raise Reject("packet hash mismatch")
    profile = load_json(PROFILE)
    if sha(jcs(profile)) != manifest["governance_profile_sha256"]: raise Reject("governance profile mismatch")
    if manifest["evaluator_task"] != profile["evaluator_task"]: raise Reject("profile task binding mismatch")
    if sha(read_root_file(TASK)) != manifest["evaluator_task"]["sha256"]: raise Reject("task content mismatch")
    governing = [row for row in manifest["governance_refs"] if row["role"] == "governing"]
    subject = [row for row in manifest["governance_refs"] if row["role"] == "subject_head_version"]
    if [row["path"] for row in governing] != profile["governing_at_base"] or any(row["source_sha"] != manifest["base_sha"] for row in governing):
        raise Reject("governing profile/source mismatch")
    if [row["path"] for row in subject] != profile["subject_at_head"] or any(row["source_sha"] != manifest["head_sha"] for row in subject):
        raise Reject("subject profile/source mismatch")
    expected_related = [{"path":row["path"],"source":row["source"],"gates":row["gates"],"justification":row["justification"]} for row in profile["related_context"]]
    observed_related = [{"path":row["path"],"source":row["source"],"gates":row["gates"],"justification":row["justification"]} for row in manifest["related_context_refs"]]
    if observed_related != expected_related: raise Reject("related-context profile mismatch")
    declared_members = {}
    for row in manifest["members"]:
        name = row["name"]
        if name in declared_members or name == "manifest.json" or name.startswith("/") or ".." in name.split("/"):
            raise Reject("unsafe or duplicate packet member")
        declared_members[name] = row
    actual_members = set()
    for root, dirs, files in os.walk(packet_dir, followlinks=False):
        if any(os.path.islink(os.path.join(root, d)) for d in dirs): raise Reject("packet directory symlink")
        for filename in files:
            path = os.path.join(root, filename)
            rel = os.path.relpath(path, packet_dir).replace(os.sep, "/")
            if rel != "manifest.json": actual_members.add(rel)
    if actual_members != set(declared_members): raise Reject("packet member set mismatch")
    total = 0
    for name, row in declared_members.items():
        data = read_root_file(os.path.join(packet_dir, name))
        if len(data) != row["size"] or sha(data) != row["sha256"]: raise Reject("packet member mismatch: " + name)
        total += len(data)
    if total != manifest["completeness"]["size_bytes"]: raise Reject("packet size mismatch")
    diff_row = declared_members.get(manifest["diff"]["member"])
    if not diff_row or diff_row["sha256"] != manifest["diff"]["sha256"]: raise Reject("diff member mismatch")
    for row in manifest["changed_files"]:
        if row["status"] == "deleted":
            if any(key in row for key in ("member", "head_content_sha256", "head_blob_sha")):
                raise Reject("deleted file carries head content")
            continue
        member = declared_members.get(row["member"])
        if not member or member["sha256"] != row["head_content_sha256"] or member["size"] != row["size"]:
            raise Reject("changed file member mismatch")
    for row in manifest["governance_refs"]:
        member = declared_members.get(row["member"])
        if not member or member["sha256"] != row["sha256"]: raise Reject("governance member mismatch")
    for row in manifest["related_context_refs"]:
        member = declared_members.get(row["member"])
        if not member or member["sha256"] != row["sha256"]: raise Reject("related-context member mismatch")
        expected_source = manifest["base_sha"] if row["source"] == "base" else manifest["head_sha"]
        if row["source_sha"] != expected_source: raise Reject("related-context source mismatch")
    if result["packet_sha256"] != declared or record["packet_sha256"] != declared: raise Reject("packet binding mismatch")
    if result["head_sha"] != manifest["head_sha"] or result["pr_number"] != manifest["pr_number"]: raise Reject("PR binding mismatch")
    rsha = sha(jcs(result))
    if record["result_sha256"] != rsha: raise Reject("result hash mismatch")
    rr = dict(record); rrhash = rr.pop("review_record_sha256")
    calc = sha(jcs({"packet_sha256":declared,"result_sha256":rsha,"invocation_record_without_hash":rr}))
    if calc != rrhash: raise Reject("review record hash mismatch")
    if record["schema_validation"] != "VALID" or record["routing_check"] != "MATCHES_TABLE": raise Reject("invalid evaluation")
    return manifest, result, record, rsha, rrhash


def render(result, packet_sha, result_sha, record_sha):
    lines = ["Independent Foundry evaluator result", "", "- Head: `"+result["head_sha"]+"`",
             "- Packet: `"+packet_sha+"`", "- Result: `"+result_sha+"`",
             "- Review record: `"+record_sha+"`", "- Overall: **"+result["overall"]+"**",
             "- Routing: **"+result["routing"]+"**", "", "Gate verdicts:"]
    for name in ("architecture","security","privacy","quality"):
        lines.append("- %s: **%s**" % (name, result["gates"][name]["verdict"]))
    if result["findings"]:
        lines += ["", "Findings:"]
        for f in result["findings"]:
            lines.append("- `%s` [%s/%s/%s] %s" % (f["finding_id"],f["gate"],f["severity"],f["category"],f["title"]))
    lines += ["", "This text is rendered mechanically from the schema-valid evaluator result."]
    return "\n".join(lines)


def main():
    if len(sys.argv) != 3: raise SystemExit("usage: foundry-evaluator-publish PACKET_DIR RUN_DIR")
    cfg = load_json(APP_CONFIG)
    if set(cfg) != {"app_id","installation_id","repository_id","owner","repo"}: raise Reject("bad app config")
    m,r,rec,rsha,rrsha = validate_evidence(os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2]))
    if (m["repository"]["owner"],m["repository"]["name"],m["repository"]["repo_id"]) != (cfg["owner"],cfg["repo"],cfg["repository_id"]):
        raise Reject("repository binding mismatch")
    token = installation_token(cfg)
    pr = api("GET","/repos/%s/%s/pulls/%s"%(cfg["owner"],cfg["repo"],m["pr_number"]),token)
    if pr["state"] != "open" or pr["head"]["sha"] != m["head_sha"]: raise Reject("stale or closed PR")
    text = render(r,m["packet_sha256"],rsha,rrsha)
    if r["overall"] == "PASS" and r["routing"] == "CONTINUE" and not r["requires_human"]:
        conclusion,event = "success","APPROVE"
    elif r["overall"] == "FAIL": conclusion,event = "failure","REQUEST_CHANGES"
    else: conclusion,event = "action_required","REQUEST_CHANGES"
    check = api("POST","/repos/%s/%s/check-runs"%(cfg["owner"],cfg["repo"]),token,
                {"name":"foundry/four-gate","head_sha":m["head_sha"],"status":"completed",
                 "conclusion":conclusion,"completed_at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                 "output":{"title":"Foundry evaluator: "+r["overall"],"summary":text[:65000]}})
    review = api("POST","/repos/%s/%s/pulls/%s/reviews"%(cfg["owner"],cfg["repo"],m["pr_number"]),token,
                 {"commit_id":m["head_sha"],"event":event,"body":text})
    print(json.dumps({"check_run_id":check["id"],"review_id":review["id"],"head_sha":m["head_sha"],
                      "packet_sha256":m["packet_sha256"],"conclusion":conclusion,"review_event":event},sort_keys=True))


if __name__ == "__main__":
    try: main()
    except (Reject,KeyError,ValueError,OSError) as e:
        print("REFUSED: "+str(e),file=sys.stderr); raise SystemExit(2)
