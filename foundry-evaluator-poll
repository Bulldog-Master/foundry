#!/usr/bin/env python3
"""Poll open Foundry PRs and run those labeled foundry-review."""
import json, subprocess, urllib.request
URL="https://api.github.com/repos/Bulldog-Master/foundry/pulls?state=open&per_page=100"
req=urllib.request.Request(URL,headers={"Accept":"application/vnd.github+json","User-Agent":"foundry-evaluator-poller/0.1"})
with urllib.request.urlopen(req,timeout=60) as r: prs=json.loads(r.read())
for pr in prs:
    if "foundry-review" in {x["name"] for x in pr.get("labels",[])}:
        subprocess.run(["/opt/foundry-evaluator/current/bin/foundry-evaluator-run",str(pr["number"])],check=False)
