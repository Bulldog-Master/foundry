{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry-2/review-result/v0.1",
  "title": "Foundry 2 evaluator result v0.1 (authored by the evaluator; contains no independence claims)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "packet_sha256",
    "pr_number",
    "head_sha",
    "evaluator_task_sha256",
    "gates",
    "findings",
    "overall",
    "routing",
    "requires_human"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "PASS_WITH_CONDITIONS",
        "N/A"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "finding_ids"
      ],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FND-[A-Z]{3,4}-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "na_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "N/A"
              }
            }
          },
          "then": {
            "required": [
              "na_reason"
            ],
            "properties": {
              "finding_ids": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "na_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "PASS_WITH_CONDITIONS"
              }
            }
          },
          "then": {
            "required": [
              "conditions"
            ],
            "properties": {
              "conditions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "FAIL"
              }
            }
          },
          "then": {
            "properties": {
              "finding_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "finding_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "result_schema_version": {
      "const": "0.1"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evaluator_task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "security",
        "privacy",
        "quality"
      ],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/gate"
        },
        "security": {
          "$ref": "#/$defs/gate"
        },
        "privacy": {
          "$ref": "#/$defs/gate"
        },
        "quality": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "gate",
          "category",
          "severity",
          "title",
          "evidence_refs"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FND-[A-Z]{3,4}-[0-9]{3,}$"
          },
          "gate": {
            "enum": [
              "architecture",
              "security",
              "privacy",
              "quality"
            ]
          },
          "category": {
            "enum": [
              "IMPLEMENTATION_DEFECT",
              "TRUST_BOUNDARY_DEFECT",
              "INTEGRITY_ANOMALY",
              "SPEC_AMBIGUITY",
              "RESERVED_ACT_REQUIRED",
              "EVIDENCE_MISSING",
              "OTHER"
            ]
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "MAJOR",
              "MINOR"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "member",
                "line_start",
                "line_end"
              ],
              "properties": {
                "member": {
                  "type": "string",
                  "minLength": 1
                },
                "repository_path": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "detail": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "overall": {
      "enum": [
        "PASS",
        "FAIL",
        "PASS_WITH_CONDITIONS"
      ]
    },
    "routing": {
      "enum": [
        "CONTINUE",
        "RETURN_TO_OPERATIONS",
        "HARD_STOP",
        "ESCALATE_FOUNDER"
      ]
    },
    "requires_human": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "gates": {
                "properties": {
                  "architecture": {
                    "properties": {
                      "verdict": {
                        "const": "FAIL"
                      }
                    },
                    "required": [
                      "verdict"
                    ]
                  }
                },
                "required": [
                  "architecture"
                ]
              }
            }
          },
          {
            "properties": {
              "gates": {
                "properties": {
                  "security": {
                    "properties": {
                      "verdict": {
                        "const": "FAIL"
                      }
                    },
                    "required": [
                      "verdict"
                    ]
                  }
                },
                "required": [
                  "security"
                ]
              }
            }
          },
          {
            "properties": {
              "gates": {
                "properties": {
                  "privacy": {
                    "properties": {
                      "verdict": {
                        "const": "FAIL"
                      }
                    },
                    "required": [
                      "verdict"
                    ]
                  }
                },
                "required": [
                  "privacy"
                ]
              }
            }
          },
          {
            "properties": {
              "gates": {
                "properties": {
                  "quality": {
                    "properties": {
                      "verdict": {
                        "const": "FAIL"
                      }
                    },
                    "required": [
                      "verdict"
                    ]
                  }
                },
                "required": [
                  "quality"
                ]
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "overall": {
            "const": "FAIL"
          }
        },
        "required": [
          "overall"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "architecture": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "architecture"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "security": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "security"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "privacy": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "privacy"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "quality": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "quality"
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "anyOf": [
              {
                "properties": {
                  "gates": {
                    "properties": {
                      "architecture": {
                        "properties": {
                          "verdict": {
                            "const": "PASS_WITH_CONDITIONS"
                          }
                        },
                        "required": [
                          "verdict"
                        ]
                      }
                    },
                    "required": [
                      "architecture"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "properties": {
                      "security": {
                        "properties": {
                          "verdict": {
                            "const": "PASS_WITH_CONDITIONS"
                          }
                        },
                        "required": [
                          "verdict"
                        ]
                      }
                    },
                    "required": [
                      "security"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "properties": {
                      "privacy": {
                        "properties": {
                          "verdict": {
                            "const": "PASS_WITH_CONDITIONS"
                          }
                        },
                        "required": [
                          "verdict"
                        ]
                      }
                    },
                    "required": [
                      "privacy"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "properties": {
                      "quality": {
                        "properties": {
                          "verdict": {
                            "const": "PASS_WITH_CONDITIONS"
                          }
                        },
                        "required": [
                          "verdict"
                        ]
                      }
                    },
                    "required": [
                      "quality"
                    ]
                  }
                }
              }
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "overall": {
            "const": "PASS_WITH_CONDITIONS"
          }
        },
        "required": [
          "overall"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "architecture": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "architecture"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "security": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "security"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "privacy": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "privacy"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "quality": {
                          "properties": {
                            "verdict": {
                              "const": "FAIL"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "quality"
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "architecture": {
                          "properties": {
                            "verdict": {
                              "const": "PASS_WITH_CONDITIONS"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "architecture"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "security": {
                          "properties": {
                            "verdict": {
                              "const": "PASS_WITH_CONDITIONS"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "security"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "privacy": {
                          "properties": {
                            "verdict": {
                              "const": "PASS_WITH_CONDITIONS"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "privacy"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "gates": {
                      "properties": {
                        "quality": {
                          "properties": {
                            "verdict": {
                              "const": "PASS_WITH_CONDITIONS"
                            }
                          },
                          "required": [
                            "verdict"
                          ]
                        }
                      },
                      "required": [
                        "quality"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "overall": {
            "const": "PASS"
          }
        },
        "required": [
          "overall"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "security": {
                "properties": {
                  "verdict": {
                    "const": "N/A"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "security"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "const": "HARD_STOP"
          },
          "requires_human": {
            "const": true
          }
        },
        "required": [
          "routing",
          "requires_human"
        ]
      }
    }
  ]
}
