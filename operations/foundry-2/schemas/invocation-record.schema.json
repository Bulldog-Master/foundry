{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry-2/invocation-record/v0.1",
  "title": "Foundry 2 evaluator invocation record v0.1 (authored by the controller from observed facts, never by the evaluator)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version", "invocation_id", "packet_sha256", "result_sha256",
    "evaluator", "environment", "accessible_context", "tools_available",
    "network_policy", "credentials_present", "prior_exposure", "attempt",
    "started_at", "completed_at", "schema_validation", "routing_check",
    "review_record_sha256"
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "properties": {
    "record_schema_version": { "const": "0.1" },
    "invocation_id": { "type": "string", "format": "uuid" },
    "packet_sha256": { "$ref": "#/$defs/sha256" },
    "result_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "config_sha256", "system_prompt_sha256"],
      "properties": {
        "provider": { "type": "string" },
        "model_id": { "type": "string" },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "system_prompt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "runtime_image_sha256", "host_id"],
      "properties": {
        "session_id": { "type": "string" },
        "runtime_image_sha256": { "$ref": "#/$defs/sha256" },
        "host_id": { "type": "string" }
      }
    },
    "accessible_context": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["packet_manifest", "packet_members", "evaluator_task", "pr_diff", "changed_file_contents", "governing_refs_at_base", "subject_governance_refs_at_head", "prior_findings_structured", "other"] }
    },
    "tools_available": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "network_policy": { "enum": ["none", "restricted", "unrestricted", "unknown"] },
    "credentials_present": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "prior_exposure": {
      "type": "object", "additionalProperties": false,
      "required": ["known_prior_sessions_on_this_pr", "knowable_limits"],
      "properties": {
        "known_prior_sessions_on_this_pr": { "type": "array", "items": { "type": "string" } },
        "knowable_limits": { "type": "string" }
      }
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "schema_validation": { "enum": ["VALID", "INVALID_MALFORMED", "INVALID_BINDING_MISMATCH", "INVALID_DERIVED_OVERALL", "INVALID_FINDING_INDEX", "INVALID_EVIDENCE_REF", "INVALID_CONTEXT", "INVALID_MEMBER_CROSS_REFERENCE", "INVALID_ROUTING", "INVALID_OTHER"] },
    "routing_check": { "enum": ["MATCHES_TABLE", "MISMATCH", "NOT_APPLICABLE"] },
    "review_record_sha256": { "$ref": "#/$defs/sha256" }
  }
}
