{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry-2/review-packet/v0.1",
  "title": "Foundry 2 frozen review packet manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_schema_version", "packet_id", "repository", "pr_number",
    "base_ref", "base_sha", "merge_base_sha", "head_repository", "head_sha",
    "changed_files", "diff", "governance_profile_sha256", "governance_refs", "evaluator_task",
    "allowed_context", "prohibited_context", "review_round",
    "producer_identity", "completeness", "members",
    "packet_created_at", "packet_sha256"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitsha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repo": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "name", "repo_id"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "repo_id": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "packet_schema_version": { "const": "0.1" },
    "packet_id": { "type": "string", "format": "uuid" },
    "repository": { "$ref": "#/$defs/repo" },
    "pr_number": { "type": "integer", "minimum": 1 },
    "base_ref": { "type": "string", "minLength": 1 },
    "base_sha": { "$ref": "#/$defs/gitsha" },
    "merge_base_sha": { "$ref": "#/$defs/gitsha" },
    "head_repository": { "$ref": "#/$defs/repo" },
    "head_sha": { "$ref": "#/$defs/gitsha" },
    "changed_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "old_path": { "type": "string" },
          "status": { "enum": ["added", "modified", "deleted", "renamed", "mode_changed"] },
          "mode": { "type": "string", "pattern": "^[0-7]{6}$" },
          "base_blob_sha": { "$ref": "#/$defs/gitsha" },
          "head_blob_sha": { "$ref": "#/$defs/gitsha" },
          "head_content_sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "member": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "added" } } }, "then": { "required": ["mode", "head_blob_sha", "head_content_sha256", "size", "member"] } },
          { "if": { "properties": { "status": { "enum": ["modified", "mode_changed"] } } }, "then": { "required": ["mode", "base_blob_sha", "head_blob_sha", "head_content_sha256", "size", "member"] } },
          { "if": { "properties": { "status": { "const": "renamed" } } }, "then": { "required": ["old_path", "mode", "base_blob_sha", "head_blob_sha", "head_content_sha256", "size", "member"] } },
          { "if": { "properties": { "status": { "const": "deleted" } } }, "then": { "required": ["base_blob_sha"], "not": { "anyOf": [{ "required": ["head_blob_sha"] }, { "required": ["head_content_sha256"] }, { "required": ["size"] }, { "required": ["member"] }] } } }
        ]
      }
    },
    "diff": {
      "type": "object", "additionalProperties": false,
      "required": ["member", "sha256", "git_version", "flags"],
      "properties": {
        "member": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "git_version": { "const": "git version 2.53.0" },
        "flags": {
          "type": "array", "items": { "type": "string" }, "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "--binary" } },
            { "contains": { "const": "--no-ext-diff" } },
            { "contains": { "const": "--no-textconv" } },
            { "contains": { "const": "--full-index" } }
          ]
        }
      }
    },
    "governance_profile_sha256": { "$ref": "#/$defs/sha256" },
    "governance_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role", "source_sha", "sha256", "member"],
        "properties": {
          "path": { "type": "string" },
          "role": { "enum": ["governing", "subject_head_version"] },
          "source_sha": { "$ref": "#/$defs/gitsha" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "member": { "type": "string" }
        }
      }
    },
    "evaluator_task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "version", "sha256"],
      "properties": {
        "task_id": { "type": "string" },
        "version": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "allowed_context": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["packet_manifest", "packet_members", "evaluator_task", "pr_diff", "changed_file_contents", "governing_refs_at_base", "subject_governance_refs_at_head"] }
    },
    "prohibited_context": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["producer_self_assessment", "producer_prose_pr_body", "other_evaluator_verdicts", "prior_findings_or_judgments", "prior_verdict_prose", "founder_approval_fields", "sealed_truth", "secrets_or_credentials", "network_access", "repository_access_outside_packet"] }
    },
    "review_round": {
      "type": "object", "additionalProperties": false,
      "required": ["round", "prior_packet_sha256"],
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "prior_packet_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "if": { "properties": { "round": { "const": 1 } } },
      "then": { "properties": { "prior_packet_sha256": { "type": "null" } } },
      "else": { "properties": { "prior_packet_sha256": { "$ref": "#/$defs/sha256" } } }
    },
    "producer_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "version", "build_sha256"],
      "properties": {
        "component": { "const": "foundry-packet-builder" },
        "version": { "type": "string" },
        "build_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "truncated", "size_bytes", "size_limit_bytes"],
      "properties": {
        "complete": { "const": true },
        "truncated": { "const": false },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "size_limit_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "packet_created_at": { "type": "string", "format": "date-time" },
    "packet_sha256": { "$ref": "#/$defs/sha256" }
  }
}
