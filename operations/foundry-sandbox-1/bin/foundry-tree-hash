#!/usr/bin/env python3

import hashlib
import os
import stat
import sys

if len(sys.argv) != 2:
    print(f"usage: {sys.argv[0]} <directory>", file=sys.stderr)
    sys.exit(64)

root = os.path.abspath(sys.argv[1])

if not os.path.isdir(root):
    print("not a directory", file=sys.stderr)
    sys.exit(66)

h = hashlib.sha256()

def add_bytes(label, data):
    h.update(label)
    h.update(len(data).to_bytes(8, "big"))
    h.update(data)

for current, dirs, files in os.walk(root, topdown=True, followlinks=False):
    dirs.sort()
    files.sort()

    rel_dir = os.path.relpath(current, root)
    if rel_dir == ".":
        rel_dir = ""

    st = os.lstat(current)
    mode = stat.S_IMODE(st.st_mode)

    add_bytes(b"D", os.fsencode(rel_dir))
    add_bytes(b"M", f"{mode:o}".encode())

    entries = sorted(dirs + files)

    for name in entries:
        path = os.path.join(current, name)
        rel = os.path.relpath(path, root)
        st = os.lstat(path)
        mode = stat.S_IMODE(st.st_mode)

        if stat.S_ISLNK(st.st_mode):
            add_bytes(b"L", os.fsencode(rel))
            add_bytes(b"M", f"{mode:o}".encode())
            add_bytes(b"T", os.fsencode(os.readlink(path)))

        elif stat.S_ISREG(st.st_mode):
            add_bytes(b"F", os.fsencode(rel))
            add_bytes(b"M", f"{mode:o}".encode())

            fh = hashlib.sha256()
            with open(path, "rb") as f:
                while True:
                    chunk = f.read(1024 * 1024)
                    if not chunk:
                        break
                    fh.update(chunk)

            add_bytes(b"H", fh.digest())

        elif stat.S_ISDIR(st.st_mode):
            # Directory itself is processed by os.walk.
            pass

        else:
            print(f"unsupported special file: {rel}", file=sys.stderr)
            sys.exit(67)

print(h.hexdigest())
